# Karaoke Propio — environment configuration
#
# Copy to .env and adjust. Every variable is optional: docker-compose.yml
# supplies a working default for each, so an empty .env still runs on the LAN.

# ---------------------------------------------------------------------------
# Host identity
# ---------------------------------------------------------------------------
# UID/GID that karaoke-eternal, pitch-worker, acquisition-worker and cdg-worker
# run as inside their containers. Must be able to read/write ./songs and
# ./ke-config on the host (see prompt_de_implementacion.md #45).
PUID=1000
PGID=1000

# Server timezone. Affects log timestamps and any server-side formatting.
# NOTE: the image installs tzdata precisely so this takes effect — Alpine
# ignores TZ without it and silently runs in UTC.
TZ=America/Lima

# ---------------------------------------------------------------------------
# Performance
# ---------------------------------------------------------------------------
# How many pitch transcodes may run at once. Each is an ffmpeg + rubberband
# process, so this is the main CPU knob. Raise it on a stronger machine;
# lower it to 1 if playback stutters while a song is being prepared.
PITCH_MAX_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Public access over the internet (optional)
# ---------------------------------------------------------------------------
# Set KARAOKE_DOMAIN and the stack wires itself to an existing nginx-proxy +
# acme-companion: virtual host, certificate and renewal, no extra container and
# no manual edits. Leave it empty and the app stays LAN-only on port 8080.
#
# Requirements: the name(s) must already resolve to this server's public IP,
# and ports 80/443 must reach the proxy. Comma-separated for several names —
# one certificate covers them all.
#KARAOKE_DOMAIN=karaoke.example.com,karaoke.example.net

# Fallback URL for the Player's QR.
#
# Normally nothing needs setting: the QR uses whichever domain the Player was
# opened at, so a server answering to several names invites people to the one
# in use. This value is only used when the Player runs on a LAN address (the
# usual case for a TV), because an invite pointing at 192.168.x.x is useless to
# a guest on mobile data.
#KARAOKE_PUBLIC_URL=https://karaoke.example.com

# ---------------------------------------------------------------------------
# UltraStar / USDB acquisition (optional)
# ---------------------------------------------------------------------------
# Enables the USDB source: search, song.txt (which carries the melody note by
# note) and the community-posted YouTube link. USDB requires an authenticated
# session for ALL of these, search included — verified live against
# usdb.animux.de (see app/server/Acquisition/UsdbClient.ts).
#
# Leave both unset to disable that source; YouTube acquisition, pitch shifting
# and everything else work without it.
#USDB_USERNAME=
#USDB_PASSWORD=
