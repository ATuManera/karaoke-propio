# Datos operativos de Karaoke Propio. Anclados a la raíz a propósito: sin la barra
# inicial, "data/" ignora CUALQUIER carpeta llamada data en cualquier nivel, y
# eso dejaba fuera del paquete app/server/Categories/data/, que es justamente la
# tabla de categorías que debe publicarse (source of truth para un grupo de canciones con categorías validadas manualmente.
/data/
/songs/

# Copias de seguridad
backups/

# Secretos y configuración local
.env
.env.*
!.env.example

# Archivos temporales
*.log
*.tmp
*.swp
.DS_Store

# Runtime data — MUST stay out of the repository.
# ke-config holds database.sqlite3, which contains user accounts (password
# hashes), room invite codes (the credential that guards public access) and
# uploaded event photos. Publishing it would hand out the invite code.
ke-config/
pitch-cache/

# scratch files while working on the repo, not part of it
tmp/
